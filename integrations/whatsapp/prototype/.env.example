APP_ENV=demo
# Fase A: para usar Gemini desde el panel, configura AI_PROVIDER=gemini en tu .env local.
# Mantén WHATSAPP_PROVIDER=mock hasta completar la prueba de Gemini.
AI_PROVIDER=mock
WHATSAPP_PROVIDER=mock
POSTGRES_PASSWORD=
# DATABASE_URL opcional fuera de Compose: postgresql+psycopg://...
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_VERSION=
META_TEMPLATE_ALERT=
META_TEMPLATE_SCHEDULE=
META_TEMPLATE_LANGUAGE=es_CO
