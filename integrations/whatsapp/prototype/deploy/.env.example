# Plantilla sin secretos para un despliegue nativo del prototipo.
# Configura los valores reales solo en el panel de secretos del alojamiento.
DATABASE_URL=
APP_ENV=demo
AI_PROVIDER=mock
WHATSAPP_PROVIDER=mock
HOST=0.0.0.0
PORT=8000
# IP del proxy HTTPS de confianza; no usar * por defecto.
FORWARDED_ALLOW_IPS=127.0.0.1
# Mismas claves del panel local si se desea conservar esos accesos.
# Generadas aleatoriamente, 32-256 caracteres URL-safe, distintas por cuenta.
PANEL_RESIDENT_TOKEN=
PANEL_ADMIN_TOKEN=
# Para Gemini, configurar AI_PROVIDER=gemini y estas variables:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
